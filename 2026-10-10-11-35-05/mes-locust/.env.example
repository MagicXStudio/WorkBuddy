# ============================================================================
# MES3.0 接口压测环境变量示例
# 复制为 .env 并按压测环境填写；脚本本身只读环境变量，不自动加载 .env，
# 可用 `export $(grep -v '^#' .env | xargs)` 或 docker-compose 的 env_file 加载。
# ============================================================================

# --- 目标服务 ----------------------------------------------------------------
# 本地联调：http://127.0.0.1:7009 ；生产/预发示例：http://api3.dbg.com.cn
# k8s 内网示例（与 mes-locust-load-generator.yaml 一致）：http://192.168.0.195
LOCUST_HOST=http://127.0.0.1:7009

# --- 统一鉴权头（取自 mes3-web/.env） ----------------------------------------
MES_APP_ID=v2NDIyMTkzD
MES_APP_SECRET=YWRtaW4iLC
MES_SYSTEM_ID=MES
MES_LANG_ID=zh-CN
# 分库因素：留空则登录后自动取用户首个授权客户；接口 2/3/4 必填
MES_CUSTOMER_ID=
MES_ORGANIZE_ID=
MES_USER_ID=admin

# --- 登录账号（用于获取 token） ---------------------------------------------
MES_USERNAME=admin
MES_PASSWORD=
# 也可以直接给一个现成 token，跳过后台登录
# MES_TOKEN=
MES_LOGIN_IN_ONSTART=true

# --- 压测行为 ---------------------------------------------------------------
MES_SKIP_REQUEST_LOG=true
MES_STRICT=false
MES_PASSSTATION_IS_QUERY=true

# --- 任务权重 ---------------------------------------------------------------
MES_W_PS_INDEX=3
MES_W_SMT_PASSSTATION=3
MES_W_BEILIAO_CHECK=2
MES_W_BIN_LOCATION=2

# --- 思考时间（秒） ---------------------------------------------------------
MES_WAIT_MIN=1
MES_WAIT_MAX=3

# --- 业务数据（务必替换为压测环境真实数据） ---------------------------------
MES_PS_SN=DEMO-SN-0001
MES_PS_STATION_ID=ST01
MES_PS_FACTORY_ID=
MES_PS_LINE_ID=

MES_SMT_LOT_NO=DEMO-LOT-0001
MES_SMT_PROCESSOR_CODE=PCBTrace
MES_SMT_ACTION=QueryInsideLotListInfo

MES_WMS_FALIAO_NO=DEMO-FL-0001
MES_WMS_REEL_ID=DEMO-REEL-0001
MES_WMS_TAO_LIANG=
MES_WMS_SHIFT=白班

MES_WMS_POSITION=A-01-01
MES_WMS_MAT_CODE=DEMO-MAT-001
MES_WMS_WAREHOUSE_ID=
MES_WMS_BIN_ACTION=Query
